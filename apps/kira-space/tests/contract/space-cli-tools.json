{
  "IssueTrackerService.Tools#not-installed": {
    "tools": [
      {
        "cli": "GitHub CLI (gh)",
        "kind": "host",
        "label": "GitHub",
        "provider": "github",
        "setup": {
          "docsUrl": "https://cli.github.com",
          "steps": [
            {
              "command": "brew install gh",
              "purpose": "install"
            },
            {
              "command": "gh auth login",
              "purpose": "login"
            },
            {
              "command": "gh auth status",
              "purpose": "check"
            }
          ]
        },
        "status": {
          "account": "octocat",
          "kind": "ok",
          "path": "<masked>",
          "probed": [],
          "reason": "",
          "site": "",
          "version": "2.42.0"
        }
      },
      {
        "cli": "Atlassian CLI (acli)",
        "kind": "tracker",
        "label": "Jira",
        "provider": "jira",
        "setup": {
          "docsUrl": "https://developer.atlassian.com/cloud/acli/guides/introduction/",
          "steps": [
            {
              "command": "brew tap atlassian/homebrew-acli && brew install acli",
              "purpose": "install"
            },
            {
              "command": "acli jira auth login --web",
              "purpose": "login"
            },
            {
              "command": "acli jira auth login --site <your-site>.atlassian.net --email <you@example.com> --token < token.txt",
              "purpose": "loginToken"
            },
            {
              "command": "acli jira auth status",
              "purpose": "check"
            }
          ]
        },
        "status": {
          "account": "",
          "kind": "notFound",
          "path": "<masked>",
          "probed": [
            "acli (on PATH)",
            "/opt/homebrew/bin/acli",
            "/usr/local/bin/acli"
          ],
          "reason": "acli is not installed",
          "site": "",
          "version": ""
        }
      }
    ]
  },
