{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../../packages/shared/*"],
      "@bindings/*": [
        "./bindings/github.com/kirathecat/kira-studio/apps/kira-space/internal/bridge/*"
      ],
      "@bindings-internal/*": [
        "./bindings/github.com/kirathecat/kira-studio/apps/kira-space/internal/*"
      ],
      "/wails/runtime.js": ["../../../node_modules/@wailsio/runtime/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../../../packages/shared/**/*.ts"]
}
