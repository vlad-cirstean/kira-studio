{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    // C10: git-ui/git-ipc source is now compiled from this project too (S9's workspace deps) —
    // both packages' own .ts files use explicit ".ts" import specifiers (their own tsconfig.json
    // already sets this), so this project needs the identical flag to follow those imports.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["../../../packages/shared/*"],
      "@bindings/*": [
        "./bindings/github.com/kirathecat/kira-studio/apps/kira-studio/internal/bridge/*"
      ],
      "@bindings-internal/*": [
        "./bindings/github.com/kirathecat/kira-studio/apps/kira-studio/internal/*"
      ],
      "/wails/runtime.js": ["../../../node_modules/@wailsio/runtime/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../../../packages/shared/**/*.ts"]
}
