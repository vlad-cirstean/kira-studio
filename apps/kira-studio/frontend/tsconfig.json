{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    // packages/theme and packages/workbench import siblings with explicit ".ts" specifiers.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // bun-types: packages/workbench/src/viteAppConfig.ts reads process.env.
    "types": ["vite/client", "bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../../packages/shared/*"],
      "@theme/*": ["../../../packages/theme/src/*"],
      "@workbench/*": ["../../../packages/workbench/src/*"],
      "@bindings/*": [
        "./bindings/github.com/kirathecat/kira-studio/apps/kira-studio/internal/bridge/*"
      ],
      "@bindings-internal/*": [
        "./bindings/github.com/kirathecat/kira-studio/apps/kira-studio/internal/*"
      ],
      "/wails/runtime.js": ["../../../node_modules/@wailsio/runtime/types/index.d.ts"]
    }
  },
  "vueCompilerOptions": { "checkUnknownComponents": true },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../../../packages/shared/**/*.ts",
    "../../../packages/theme/src/**/*.ts",
    "../../../packages/theme/src/**/*.vue",
    "../../../packages/workbench/src/**/*.ts",
    "../../../packages/workbench/src/**/*.vue",
    "../../../packages/workbench/env.d.ts"
  ]
}
