{
  "info": {
    "name": "Flow Orders",
    "description": "fixture for the apiflow import test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.collectionVariables.set('t', Date.now());"]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "__BASE_URL__", "type": "secret" },
    { "key": "apiVersion", "value": "v2" }
  ],
  "item": [
    {
      "name": "Orders",
      "auth": { "type": "basic", "basic": [{ "key": "username", "value": "u" }] },
      "event": [{ "listen": "prerequest", "script": { "exec": ["// folder script"] } }],
      "item": [
        {
          "name": "Create order",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('created', () => {});"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Flow", "value": "orders" }],
            "url": "{{baseUrl}}/echo?v={{apiVersion}}",
            "body": {
              "mode": "raw",
              "raw": "{\"sku\":\"x\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Upload report",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/echo",
            "body": { "mode": "file", "file": { "src": "/Users/someone/report.csv" } }
          }
        }
      ]
    },
    {
      "name": "Search",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/echo",
        "body": {
          "mode": "graphql",
          "graphql": { "query": "{ me { id } }", "variables": "{}" }
        }
      }
    },
    {
      "name": "List orders",
      "request": { "method": "GET", "url": "{{baseUrl}}/echo?list=1" }
    }
  ]
}
