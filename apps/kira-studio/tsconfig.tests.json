{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["../../packages/shared/*"]
    }
  },
  "include": [
    "../../packages/shared/**/*.ts",
    "playwright.config.ts",
    "tests/e2e-real/**/*.ts",
    "tests/ui/**/*.ts",
    "../../packages/db-fixtures/support/**/*.ts",
    "tests/ipc/**/*.ts"
  ]
}
