{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    // allowImportingTsExtensions is for packages/kira-ui's .ts specifiers.
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@shared/*": ["../../packages/shared/*"],
      "@theme/*": ["../../packages/theme/src/*"],
      "@workbench/*": ["../../packages/workbench/src/*"]
    }
  },
  "include": [
    "../../packages/shared/**/*.ts",
    "../../packages/workbench/src/**/*.ts",
    "../../packages/workbench/env.d.ts",
    "playwright.config.ts",
    "playwright.perf.config.ts",
    "playwright.proto.config.ts",
    "tests/e2e-real/**/*.ts",
    "tests/perf/**/*.ts",
    "tests/proto/**/*.ts",
    "tests/ui/**/*.ts",
    "tests/perf/**/*.ts",
    "tests/visual/**/*.ts",
    "../../packages/db-fixtures/support/**/*.ts",
    "tests/ipc/**/*.ts",
    "tests/support/**/*.ts"
  ],
  // P103 Part 1: testing/unit/* imports `bun:test` (this project's own `types` is `["node"]`,
  // for tests/ui's Playwright surface, not `bun-types`) — apps/*/tests/unit/tsconfig.json is
  // its real project. P127: same reason for any *.spec.ts colocated under packages/workbench/src
  // (agent-activity-reducer.spec.ts, packages/git-core/src's own precedent) — apps/*/tests/unit/
  // tsconfig.json already covers it via its own `packages/workbench/src/**/*.ts` include.
  "exclude": [
    "../../packages/workbench/src/testing/unit/**",
    "../../packages/workbench/src/**/*.spec.ts"
  ]
}
