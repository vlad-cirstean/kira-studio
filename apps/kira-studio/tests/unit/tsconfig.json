{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun-types"],
    "paths": {
      "@shared/*": ["../../../../packages/shared/*"],
      "@bindings/*": [
        "../../frontend/bindings/github.com/kirathecat/kira-studio/apps/kira-studio/internal/bridge/*"
      ],
      "@bindings-internal/*": [
        "../../frontend/bindings/github.com/kirathecat/kira-studio/apps/kira-studio/internal/*"
      ]
    }
  },
  "include": ["**/*.ts", "../../frontend/src/env.d.ts"]
}
