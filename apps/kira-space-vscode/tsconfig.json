{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vscode", "vite/client", "bun-types"],
    // P131 Part 1 §3.3: the webview's own tailwind.css/kira-bridge.css import packages/theme/src
    // by this alias (mirroring packages/git-ui/tsconfig.json's own entry).
    "paths": {
      "@theme/*": ["../../packages/theme/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
