{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    // shared/domain reaches the i18n runtime through @theme/i18n, whose index re-exports a .vue file.
    "paths": { "@theme/*": ["../theme/src/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../workbench/env.d.ts"]
}
