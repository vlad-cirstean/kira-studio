{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun-types"],
    // Only so `bun test` resolves `@theme/*` imports from specs under packages/theme/src; each
    // consuming app's own tsconfig type-checks this source.
    "paths": {
      "@shared/*": ["../shared/*"],
      "@theme/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
