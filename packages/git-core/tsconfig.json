{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    // Type-only import of MessageKey; the i18n index re-exports a .vue file, hence the env shim.
    "paths": { "@theme/*": ["../theme/src/*"] }
  },
  "include": ["src/**/*.ts", "../workbench/env.d.ts"]
}
