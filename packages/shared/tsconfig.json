{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // Not a typecheck target: each consuming app's tsconfig compiles this package's source. It exists
    // so `bun test` resolves `@theme/i18n` for domain files (connection, sql-lint) reached from unit specs.
    "paths": {
      "@theme/*": ["../theme/src/*"]
    }
  },
  "include": ["**/*.ts"]
}
