{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun-types"],
    // P107 I2-27: *.test.ts's own testing-only import of @workbench/testing/unit/async
    // (deferred/sleep) — the same alias every frontend app's own tsconfig already gives it.
    "paths": {
      "@workbench/*": ["../workbench/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
