<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kira_studio_shell"
        Arguments=""
        InstallLocation="C:\Program Files\Kira the Cat\Kira Studio Shell">
    </Installer>
    <PackageInformation
        PackageName="Kira Studio Shell"
        PackageDisplayName="Kira Studio Shell"
        PublisherName="CN=Kira the Cat"
        PublisherDisplayName="Kira the Cat"
        Version="0.0.0.0"
        PackageDescription="A visual database client for macOS">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.kirathecat.kira-studio-shell"
                Description="A visual database client for macOS"
                DisplayName="Kira Studio Shell"
                ExecutableName="kira_studio_shell"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Kira Studio Shell</DisplayName>
            <PublisherDisplayName>Kira the Cat</PublisherDisplayName>
            <Description>A visual database client for macOS</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kira_studio_shell.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
