# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Playwright
test-results/
playwright-report/

# macOS
.DS_Store

# Claude Code agent worktrees — isolated scratch checkouts for background
# subagents (see .claude/worktrees/*), never repo content.
.claude/

# Design canvas — the seeded page is a 3 MB build product (it bundles the
# canvas editor). Rebuild it with docs/design/kira-design-system/build.mjs
# and the design skill's seed-canvas.mjs; the design itself lives in parts/.
docs/design/*/[a-z]*-design-system.html

# SQLite demo database — a build product of scripts/demo-dbs/sqlite/seed.ts,
# regenerated on demand (P35 D36); the other seven engines' demo data lives
# in containers instead, so this is the one on-disk artifact of the set.
scripts/demo-dbs/sqlite/*.sqlite

# P51 NeutralinoJS spike shell (docs/v1/plans/P51-neutralino-migration-spike.md)
# — neutralino/bin/ is ~22 MB of platform binaries `neu update` regenerates;
# neutralino/resources/ is built from out/renderer/ by
# scripts/build-neutralino-shell.sh (D4/D6). .tmp/ is the CLI's own
# auth-info/log scratch dir.
neutralino/bin/
neutralino/resources/
neutralino/.tmp/

# Vendored Node runtime + kafka-javascript native addon for a packaged Neutralino engine
# process (scripts/fetch-neutralino-engine-runtime.sh) — build-time fetches, not repo content,
# same treatment as neutralino/bin/. See P51 §9.3.
neutralino/engine-runtime/
