(version 1)
;; kira-sbpl/1 run=run-1 access=write network=true
;; loopback ports: 4100
(allow default)

;; escapes
(deny appleevent-send)
(deny mach-lookup
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name-prefix "com.apple.lsd.")
  (global-name "com.apple.pasteboard.1"))
(deny signal)
(allow signal (target same-sandbox))

;; reads
(deny file-read-data
  (subpath "/Users")
  (subpath "/Volumes"))
(allow file-read-data
  (subpath "/Users/ada/.claude")
  (regex #"^/Users/ada/\.claude\.json")
  (literal "/Users/ada/.gitconfig")
  (subpath "/Users/ada/.config/git")
  (literal "/Users/ada/.zshenv")
  (literal "/Users/ada/.zprofile")
  (literal "/Users/ada/.zshrc")
  (literal "/Users/ada/.zlogin")
  (literal "/Users/ada/.bashrc")
  (literal "/Users/ada/.bash_profile")
  (literal "/Users/ada/.profile")
  (subpath "/Users/ada/.kira-memory")
  (subpath "/Users/ada/Library/Keychains")
  (subpath "/Users/ada/.nvm/versions/node/v22.1.0")
  (subpath "/Users/ada/go")
  (subpath "/Users/ada/.local/share/claude")
  (subpath "/Users/ada/src/app-wt/feat")
  (subpath "/Users/ada/src/app-wt/feat2")
  (subpath "/Users/ada/src/app/.git/worktrees/feat")
  (subpath "/Users/ada/src/app/.git")
  (subpath "/Users/ada/src/app/.git/worktrees/feat2")
  (subpath "/Users/ada/Library/Application Support/Kira/agent/sandbox/run-1")
  (subpath "/Users/ada/Library/Application Support/Kira/agent/sandbox-cache")
  (regex #"^/Users/ada/Library/Application Support/Kira/agent/run-1-([0-9]+|user)\.mcp\.json$"))

;; writes
(deny file-write*)
(allow file-write*
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (literal "/dev/dtracehelper")
  (regex #"^/dev/ttys[0-9]+$")
  (regex #"^/dev/fd/")
  (subpath "/Users/ada/Library/Application Support/Kira/agent/sandbox/run-1")
  (subpath "/Users/ada/Library/Application Support/Kira/agent/sandbox-cache")
  (subpath "/private/var/folders/ab/cd/T")
  (subpath "/private/var/folders/ab/cd/C")
  (subpath "/Users/ada/.claude")
  (regex #"^/Users/ada/\.claude\.json")
  (subpath "/Users/ada/.kira-memory"))

;; worktrees
(allow file-write*
  (subpath "/Users/ada/src/app-wt/feat")
  (subpath "/Users/ada/src/app-wt/feat2"))

;; git
(deny file-write*
  (subpath "/Users/ada/src/app/.git"))
(allow file-write*
  (subpath "/Users/ada/src/app/.git/worktrees/feat"))
(allow file-write*
  (subpath "/Users/ada/src/app/.git/objects"))
(allow file-write*
  (literal "/Users/ada/src/app/.git/refs/heads/task/feat")
  (literal "/Users/ada/src/app/.git/refs/heads/task/feat.lock")
  (literal "/Users/ada/src/app/.git/logs/refs/heads/task/feat")
  (literal "/Users/ada/src/app/.git/logs/refs/heads/task/feat.lock"))
(allow file-write-create
  (literal "/Users/ada/src/app/.git/refs/heads/task")
  (literal "/Users/ada/src/app/.git/logs/refs/heads/task"))
(allow file-write*
  (subpath "/Users/ada/src/app/.git/worktrees/feat2"))
(allow file-write*
  (subpath "/Users/ada/src/app/.git/objects"))
(allow file-write*
  (literal "/Users/ada/src/app/.git/refs/heads/task/feat2")
  (literal "/Users/ada/src/app/.git/refs/heads/task/feat2.lock")
  (literal "/Users/ada/src/app/.git/logs/refs/heads/task/feat2")
  (literal "/Users/ada/src/app/.git/logs/refs/heads/task/feat2.lock"))
(allow file-write-create
  (literal "/Users/ada/src/app/.git/refs/heads/task")
  (literal "/Users/ada/src/app/.git/logs/refs/heads/task"))
(deny file-write*
  (literal "/Users/ada/src/app-wt/feat/.git")
  (literal "/Users/ada/src/app/.git/worktrees/feat/gitdir")
  (literal "/Users/ada/src/app/.git/worktrees/feat/commondir")
  (literal "/Users/ada/src/app/.git/worktrees/feat/locked")
  (literal "/Users/ada/src/app/.git/worktrees/feat/config.worktree"))
(deny file-write-unlink
  (literal "/Users/ada/src/app/.git/worktrees/feat"))
(deny file-write*
  (literal "/Users/ada/src/app-wt/feat2/.git")
  (literal "/Users/ada/src/app/.git/worktrees/feat2/gitdir")
  (literal "/Users/ada/src/app/.git/worktrees/feat2/commondir")
  (literal "/Users/ada/src/app/.git/worktrees/feat2/locked")
  (literal "/Users/ada/src/app/.git/worktrees/feat2/config.worktree"))
(deny file-write-unlink
  (literal "/Users/ada/src/app/.git/worktrees/feat2"))
(deny file-write-unlink file-write-data file-write-mode
  (regex #"^/Users/ada/src/app/\.git/objects/[0-9a-f]{2}/[0-9a-f]{38,62}$")
  (regex #"^/Users/ada/src/app/\.git/objects/pack/pack-[0-9a-f]+\.(pack|idx|rev|bitmap|keep)$"))

;; protections
(deny file-write*
  (literal "/Users/ada/.claude/settings.json")
  (literal "/Users/ada/.claude/settings.local.json")
  (literal "/Users/ada/.claude/CLAUDE.md")
  (literal "/Users/ada/.claude/keybindings.json")
  (subpath "/Users/ada/.claude/commands")
  (subpath "/Users/ada/.claude/agents")
  (subpath "/Users/ada/.claude/skills")
  (subpath "/Users/ada/.claude/plugins")
  (subpath "/Users/ada/.claude/hooks")
  (subpath "/Users/ada/.claude/output-styles")
  (subpath "/Users/ada/Library/Keychains"))

;; network
(deny network-outbound (remote unix-socket (path-literal "/private/tmp/com.apple.launchd.X/Listeners")))
