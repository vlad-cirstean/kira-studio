{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probe",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "target"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "description": "Display name." },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "default": 1,
      "description": "Attempts before giving up."
    },
    "mode": { "enum": ["fast", "safe"], "default": "safe", "description": "Run mode." },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "x-kira-ref": true,
          "description": "Endpoint, may hold references."
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string", "x-kira-secret": true },
          "description": "Header values; each must be one secret reference."
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]+$" },
      "description": "Free tags."
    }
  }
}
