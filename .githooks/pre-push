#!/bin/sh
# Kira Studio pre-push — P94 §5, scoped by P294. Branch names (scripts/check-push-refs.sh) first; then the heavier checks, run where a cold
# multi-minute wait is acceptable and a per-commit one is not. Scoped to the pushed range: Go lint
# and tests only for changed Go packages (nested modules lint in their own dir, no tests), knip only when frontend code or package config changed;
# `go build ./...` always runs (a link error can sit in an unchanged dependent). Config, lockfile or
# script changes fall back to the full run.
# Bypass mid-investigation only: git push --no-verify
set -e

# Branch names first (P330): cheap, and needs no node_modules.
REFS="$(cat)"
printf '%s\n' "$REFS" | sh scripts/check-push-refs.sh

if [ ! -d node_modules ]; then
  echo "pre-push: node_modules is missing — run \`bun install\` first." >&2
  exit 1
fi

. scripts/hook-scope.sh
ZERO=0000000000000000000000000000000000000000
FILES=""
FULL=0
PUSHED=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue
  PUSHED=1
  if [ "$rsha" = "$ZERO" ]; then
    base="$(git merge-base "$lsha" origin/main 2>/dev/null || true)"
  else
    base="$rsha"
  fi
  if [ -z "$base" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    FULL=1
  else
    FILES="$FILES
$(git diff --name-only --diff-filter=ACMRD "$base" "$lsha")"
  fi
done <<EOF
$REFS
EOF
FILES="$(printf '%s\n' "$FILES" | sed '/^$/d' | sort -u)"
if [ "$FULL" = 1 ] || { [ -n "$FILES" ] && is_full "$FILES"; }; then
  echo "pre-push: config or unknown range, full run"
  go build ./...
  bun run lint:go
  bun run lint:dead
  exit 0
fi
[ "$PUSHED" = 1 ] || exit 0

go build ./...
DIRS="$(go_dirs "$FILES" | while read -r d; do [ -d "$d" ] && echo "$d"; done)"
if [ -n "$DIRS" ]; then
  sh scripts/install-golangci-lint.sh
  # shellcheck disable=SC2086
  "$(go env GOPATH)/bin/golangci-lint" run $DIRS
  # Container packages need Docker and run in CI; test the rest.
  # shellcheck disable=SC2086
  TESTDIRS="$(echo $DIRS | tr ' ' '\n' | grep -Ev '/internal/adapters/|/internal/ipcfixture|/flows/dockerflow|/flows/dbflow' || true)"
  # shellcheck disable=SC2086
  [ -z "$TESTDIRS" ] || go test $TESTDIRS
fi
# Nested modules (apps/*/tests/claude) lint on their own; their tests are opt-in and cost tokens.
NESTED="$(nested_go_mods "$FILES" | while read -r m; do [ -d "$m" ] && echo "$m"; done)"
if [ -n "$NESTED" ]; then
  sh scripts/install-golangci-lint.sh
  for m in $NESTED; do
    (cd "$m" && "$(go env GOPATH)/bin/golangci-lint" run)
  done
fi
if any "$FILES" '\.(ts|mts|vue)$'; then
  bun run lint:dead
fi
