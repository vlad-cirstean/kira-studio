{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!out",
      "!dist",
      "!test-results",
      "!playwright-report",
      "!node_modules",
      "!docs/v1/design",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["src/renderer/views/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/workbench/**"],
                    "message": "SPEC §11: views/* must not import from workbench/* — the dependency graph stays a tree."
                  },
                  {
                    "group": [
                      "../grid/**",
                      "../documents/**",
                      "../keyvalue/**",
                      "../stream/**",
                      "../console/**",
                      "../definition/**",
                      "../../grid/**",
                      "../../documents/**",
                      "../../keyvalue/**",
                      "../../stream/**",
                      "../../console/**",
                      "../../definition/**"
                    ],
                    "message": "SPEC §11: views/<kind>/* must not import another views/<kind>/* — use views/shared/ instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/**", "!src/main/storage/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["drizzle-orm", "drizzle-orm/**"],
                    "message": "SPEC §11: the Drizzle instance is only ever touched by main/storage/db.ts and its repos/ — a caller reaches storage through repos/, not the ORM directly."
                  },
                  {
                    "group": ["node:sqlite"],
                    "message": "SPEC §11: main/storage/db.ts is the only file that opens the SQLite database directly."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/storage/**", "!src/main/storage/db.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:sqlite"],
                    "message": "SPEC §11: db.ts is the only file that opens the SQLite database directly — repos/ takes the Drizzle instance db.ts hands them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/engine/adapters/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["electron"],
                    "message": "Adapter rule 1: an adapter imports nothing from electron — it is a plain Node module, which is what lets tests/db/ import it directly."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/engine/adapters/s3/**", "!src/engine/adapters/s3/transfer.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["electron"],
                    "message": "Adapter rule 1: an adapter imports nothing from electron — it is a plain Node module, which is what lets tests/db/ import it directly."
                  },
                  {
                    "group": ["node:fs", "node:fs/**"],
                    "message": "SPEC §11: transfer.ts is the only file in the s3 adapter that touches node:fs."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/project/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/views/**"],
                    "message": "SPEC §11: project/ must not import views/ directly — dispatch through state/viewCommands.ts instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
