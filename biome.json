{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!test-results",
      "!playwright-report",
      "!node_modules",
      "!docs/design",
      "!.claude",
      "!packages/shared/protocol/wire.ts",
      "!packages/shared/protocol/wire"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/kira-studio/frontend/src/views/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/workbench/**"],
                    "message": "SPEC §11: views/* must not import from workbench/* — the dependency graph stays a tree."
                  },
                  {
                    "group": [
                      "../grid/**",
                      "../documents/**",
                      "../keyvalue/**",
                      "../stream/**",
                      "../console/**",
                      "../definition/**",
                      "../browse/**",
                      "../httprequest/**",
                      "../../grid/**",
                      "../../documents/**",
                      "../../keyvalue/**",
                      "../../stream/**",
                      "../../console/**",
                      "../../definition/**",
                      "../../browse/**",
                      "../../httprequest/**"
                    ],
                    "message": "SPEC §11: views/<kind>/* must not import another views/<kind>/* — use views/shared/ instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/kira-studio/frontend/src/project/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/views/**"],
                    "message": "SPEC §11: project/ must not import views/ directly — dispatch through state/viewCommands.ts instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/kira-studio/frontend/src/http/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/project/**"],
                    "message": "P1 D7: http/ must not import project/ — Studio's connection tree is not Http's to reach into."
                  },
                  {
                    "group": ["**/views/**"],
                    "message": "P1 D7: http/ must not import views/ directly, mirroring project/'s own rule — dispatch through state/viewCommands.ts instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/kira-studio/frontend/src/git/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/project/**"],
                    "message": "v1.3 P1 §0.3: git/ must not import project/ — Studio's connection tree is not Git's to reach into."
                  },
                  {
                    "group": ["**/http/**"],
                    "message": "v1.3 P1 §0.3: git/ must not import http/ — Studio/Http/Git stay three separate modules (docs/v1.3/SPEC.md)."
                  },
                  {
                    "group": ["**/views/**"],
                    "message": "v1.3 P1 §0.3: git/ must not import views/ directly, mirroring http/'s own rule — dispatch through state/viewCommands.ts instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ipc-core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kira/*", "**/git-*/**"],
                    "message": "v1.3 P1 iter2 D10: ipc-core is the module-agnostic half of the RPC-over-a-stream protocol and depends on nothing — not by a relative import either (packages/ipc-core/package.json's empty dependencies already states this at the manifest level)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
