---
import { type AppContent, INSTALL } from '../data/content';
import { REPO_URL } from '../data/nav';

interface Props {
  app: AppContent;
}

const { app } = Astro.props;
---

<section id="install" class="border-t border-border">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-semibold sm:text-3xl">Install {app.name}</h2>
    <ol class="mt-3 max-w-2xl list-decimal space-y-2 pl-5 text-fg">
      {INSTALL.steps.map((step) => <li>{step}</li>)}
    </ol>
    <pre
      class="mt-6 whitespace-pre-wrap break-all rounded-md border border-border bg-chrome p-4 font-mono text-sm"
    ><code>{INSTALL.command(app.id)}</code></pre>
    <p class="mt-6 max-w-2xl text-base text-muted">{INSTALL.note}</p>
    <p class="mt-3 text-base">
      <a href={REPO_URL} rel="noopener" class="text-accent underline underline-offset-4">
        {INSTALL.source}
      </a>
    </p>
  </div>
</section>
