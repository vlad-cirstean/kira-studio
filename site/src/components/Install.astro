---
import { APPS, INSTALL } from '../data/content';
import { REPO_URL } from '../data/nav';
---

<section id="install" class="border-t border-border">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-semibold sm:text-3xl">Install</h2>
    <p class="mt-3 max-w-2xl text-fg">{INSTALL.steps}</p>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {APPS.map((app) => (
        <div>
          <h3 class="font-medium">{app.name}</h3>
          <pre class="mt-2 whitespace-pre-wrap break-all rounded-md border border-border bg-chrome p-4 font-mono text-sm"><code>{INSTALL.command(app.id)}</code></pre>
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-2xl text-base text-muted">{INSTALL.note}</p>
    <p class="mt-3 text-base">
      <a href={REPO_URL} rel="noopener" class="text-accent underline underline-offset-4">
        {INSTALL.source}
      </a>
    </p>
  </div>
</section>
