---
import { type AppContent, INSTALL } from '../data/content';
import { REPO_URL } from '../data/nav';
import Icon from './Icon.astro';

interface Props {
  app: AppContent;
}

const { app } = Astro.props;
---

<section id="install" class="mx-auto max-w-5xl px-4 pb-20">
  <div class="h-px bg-gradient-to-r from-transparent via-border-strong to-transparent"></div>
  <h2 class="mt-16 text-2xl font-semibold tracking-tight sm:text-4xl">Install {app.name}</h2>
  <ol class="mt-8 grid gap-4 md:grid-cols-2">
    <li class="rounded-xl border border-border bg-elevated p-5 shadow-card">
      <span
        class="flex size-8 items-center justify-center rounded-full bg-tint/10 text-sm font-semibold text-tint ring-1 ring-tint/20"
        >1</span
      >
      <p class="mt-3 text-base text-fg">{INSTALL.steps[0]}</p>
      <div class="mt-4 overflow-hidden rounded-lg border border-border-strong bg-chrome">
        <div
          class="flex items-center gap-2 border-b border-border-strong px-3 py-2 text-sm text-subtle"
        >
          <Icon name="terminal" class="size-4" />
          <span>{app.name}</span>
        </div>
        <pre
          class="whitespace-pre-wrap break-all p-4 font-mono text-sm"
        ><code>{INSTALL.command(app.id)}</code></pre>
      </div>
    </li>
    <li class="rounded-xl border border-border bg-elevated p-5 shadow-card">
      <span
        class="flex size-8 items-center justify-center rounded-full bg-tint/10 text-sm font-semibold text-tint ring-1 ring-tint/20"
        >2</span
      >
      <p class="mt-3 flex gap-3 text-base text-fg">
        <Icon name="lock" class="mt-1 size-4 text-tint" />
        <span>{INSTALL.steps[1]}</span>
      </p>
    </li>
  </ol>
  <div class="mt-6 flex gap-3 rounded-xl border border-warn/40 bg-warn/10 p-4 text-base text-fg">
    <Icon name="warning" class="mt-1 size-4 text-warn" />
    <p>{INSTALL.note}</p>
  </div>
  <p class="mt-6 text-base">
    <a href={REPO_URL} rel="noopener" class="text-accent underline underline-offset-4">
      {INSTALL.source}
    </a>
  </p>
</section>
