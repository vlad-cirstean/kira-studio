---
import { type AppContent, SITE } from '../data/content';
import { href, REPO_URL } from '../data/nav';
import type { ResolvedShot } from '../lib/shots';
import Icon from './Icon.astro';
import Shot from './Shot.astro';

interface Props {
  app: AppContent;
  shot: ResolvedShot;
}

const { app, shot } = Astro.props;
const button =
  'flex min-h-11 items-center gap-2 rounded-lg px-5 font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
const secondary = `${button} border border-border-strong bg-elevated/60 text-fg hover:bg-elevated`;
---

<section class="mx-auto max-w-5xl px-4 pb-16 pt-10 sm:pt-16">
  <span class="flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-tint">
    <Icon name={app.icon} class="size-4" />
    {SITE.availability}
  </span>
  <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">{app.name}</h1>
  <p class="mt-4 max-w-2xl text-base text-muted sm:text-lg">{app.summary}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="#install" class={`${button} bg-accent text-accent-fg hover:opacity-90`}>
      <Icon name="cloud-download" class="size-4" />
      Install
    </a>
    <a href={href(app.docs)} class={secondary}>
      <Icon name="book" class="size-4" />
      Docs
    </a>
    <a href={REPO_URL} rel="noopener" class={secondary}>
      <Icon name="github" class="size-4" />
      GitHub
    </a>
  </div>
  <div class="mt-12">
    <Shot shot={shot} eager glow />
  </div>
</section>
