---
import type { AppContent } from '../data/content';
import type { ResolvedShot } from '../lib/shots';
import Shot from './Shot.astro';

interface Props {
  app: AppContent;
  shots: readonly ResolvedShot[];
}

const { app, shots } = Astro.props;
---

<section id={app.id} class="border-t border-border">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-semibold sm:text-3xl">{app.name}</h2>
    <p class="mt-3 max-w-2xl text-fg">{app.summary}</p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {app.features.map((feature) => (
        <li class="rounded-md border border-border bg-elevated px-4 py-3 text-base">{feature}</li>
      ))}
    </ul>
    <div class="mt-10 grid gap-8">
      {shots.map((shot) => <Shot shot={shot} />)}
    </div>
  </div>
</section>
