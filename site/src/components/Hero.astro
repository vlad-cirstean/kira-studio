---
import { SITE } from '../data/content';
import { REPO_URL } from '../data/nav';
import type { ResolvedShot } from '../lib/shots';
import Shot from './Shot.astro';

interface Props {
  shot: ResolvedShot;
}

const { shot } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 pb-12 pt-10 sm:pt-16">
  <h1 class="text-3xl font-semibold tracking-tight sm:text-5xl">{SITE.title}</h1>
  <p class="mt-4 max-w-2xl text-lg text-fg">{SITE.tagline}</p>
  <p class="mt-2 text-base text-muted">{SITE.availability}</p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a
      href="#install"
      class="flex min-h-11 items-center rounded-md bg-accent px-5 font-medium text-accent-fg hover:opacity-90"
    >
      Install
    </a>
    <a
      href={REPO_URL}
      rel="noopener"
      class="flex min-h-11 items-center rounded-md border border-border px-5 font-medium text-fg hover:bg-elevated"
    >
      GitHub
    </a>
  </div>
  <div class="mt-10">
    <Shot shot={shot} eager />
  </div>
</section>
