---
import type { Highlight } from '../data/content';
import type { ResolvedShot } from '../lib/shots';
import Icon from './Icon.astro';
import Shot from './Shot.astro';

interface Props {
  highlight: Highlight;
  shot: ResolvedShot;
  flip?: boolean;
}

const { highlight, shot, flip = false } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4">
  <div class="h-px bg-gradient-to-r from-transparent via-border-strong to-transparent"></div>
  <div class="grid items-center gap-8 py-16 md:grid-cols-5 md:gap-12">
    <div class:list={['md:col-span-2', flip && 'md:order-2']}>
      <span class="flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-tint">
        <Icon name={shot.icon} class="size-4" />
        {shot.label}
      </span>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-4xl">{highlight.title}</h2>
      <ul class="mt-5 space-y-2">
        {highlight.points.map((point) => (
          <li class="flex gap-2 text-base text-fg">
            <Icon name="check" class="mt-1 size-4 text-tint" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class:list={['md:col-span-3', flip && 'md:order-1']}>
      <Shot shot={shot} />
    </div>
  </div>
</section>
