---
import type { Feature } from '../data/content';
import Icon from './Icon.astro';

interface Props {
  features: readonly Feature[];
}

const { features } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 pb-16">
  <h2 class="text-2xl font-semibold tracking-tight sm:text-4xl">What you get</h2>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f) => (
      <li class="rounded-xl border border-border bg-elevated p-5 shadow-card hover:border-tint/40 motion-safe:transition-colors">
        <span class="flex size-10 items-center justify-center rounded-lg bg-tint/10 text-tint ring-1 ring-tint/20">
          <Icon name={f.icon} class="size-5" />
        </span>
        <h3 class="mt-4 font-medium text-fg">{f.title}</h3>
        <p class="mt-1 text-base text-muted">{f.body}</p>
      </li>
    ))}
  </ul>
</section>
