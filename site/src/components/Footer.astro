---
import { REPO_URL } from '../data/nav';
---

<footer class="border-t border-border bg-chrome">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 px-4 py-6 text-base text-muted">
    <span>MIT licence.</span>
    <a href={REPO_URL} rel="noopener" class="flex min-h-11 items-center hover:text-fg">GitHub</a>
    <a
      href={`${REPO_URL}/tree/main/site`}
      rel="noopener"
      class="flex min-h-11 items-center hover:text-fg"
    >
      Source of this page
    </a>
    <span>
      Icons:
      <a
        href="https://github.com/microsoft/vscode-codicons"
        rel="noopener"
        class="underline underline-offset-4 hover:text-fg"
        >Codicons</a
      >
      by Microsoft,
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        rel="noopener"
        class="underline underline-offset-4 hover:text-fg"
        >CC BY 4.0</a
      >.
    </span>
  </div>
</footer>
