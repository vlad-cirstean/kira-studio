---
import { ICONS, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
const a11y = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const };
---

<span
  class:list={['inline-flex shrink-0 [&>svg]:size-full', className]}
  {...a11y}
  set:html={ICONS[name]}
/>
