# P94 §6 — adds golangci-lint (lint:go) and knip (lint:dead) to the checks job.
# P106 — renames the Studio-only script invocations this file makes (build, test:ui, test:ipc:fe,
# test:visual) to their now-explicit :studio suffix.
# Apply with `git apply docs/pending-changes/.github__workflows__pr.yml.patch` then delete this file.

diff --git a/.github/workflows/pr.yml b/.github/workflows/pr.yml
index 02dc277..2d58b04 100644
--- a/.github/workflows/pr.yml
+++ b/.github/workflows/pr.yml
@@ -18,7 +18,7 @@
   checks:
     name: checks (macOS)
     runs-on: macos-15
-    timeout-minutes: 15
+    timeout-minutes: 20
     steps:
       - uses: actions/checkout@v7
       - uses: oven-sh/setup-bun@v2
@@ -49,7 +49,14 @@
         run: sh scripts/setup.sh
       - run: bun run lint
       - run: bun run typecheck
-      - run: bun run build
+      - run: bun run build:studio
+      - name: Cache golangci-lint binary (P94 — keyed on the install script, which pins the version, and go.mod, which pins the toolchain it's built against; built from source since neither the prebuilt binary nor golangci/golangci-lint-action tolerate this repo's go.mod toolchain pin, docs/DEV_ENVIRONMENT.md)
+        uses: actions/cache@v4
+        with:
+          path: ~/go/bin/golangci-lint
+          key: golangci-lint-${{ runner.os }}-${{ hashFiles('scripts/install-golangci-lint.sh', 'go.mod') }}
+      - run: bun run lint:go
+      - run: bun run lint:dead
       - name: Go compile check, every package (darwin build-tag breaks caught here even though the test run below is scoped)
         run: go build ./...
       - name: Go unit tests, darwin-relevant packages only (v1.4 P1 — container-tests already runs the full ./... on Linux with Docker, covering every non-container case here too, so a macOS-only full run was pure duplication; these five have real darwin&&cgo test/implementation files — secrets, metrics, localauth, gitclient, datagrip)
@@ -151,11 +158,11 @@
           key: playwright-${{ runner.os }}-${{ hashFiles('bun.lock') }}
       - name: Install WebKit and Chromium with their system libraries (CLAUDE.md — webkit is what `ui`/`ui-timing`/`visual` run against, chromium is what `ipc-frontend` runs against per playwright.config.ts; --with-deps delegates to Playwright's own per-browser dependency list rather than a hand-maintained apt package list that already fell out of sync once when chromium was added)
         run: bunx playwright install --with-deps webkit chromium
-      - run: bun run test:ui
+      - run: bun run test:ui:studio
       - name: IPC frontend tests (v1.4 P1 — previously in no CI job; consumes the fixtures internal/adapters/*'s own suites generate, closing the anti-drift gap)
-        run: bun run test:ipc:fe
+        run: bun run test:ipc:fe:studio
       - name: Visual regression tests (v1.4 P6 — bounded pixel-diff tier, docs/v1.4/plans/P6-visual-regression.md; baselines are only ever captured/updated from this job's own environment, see tests/visual/README.md)
-        run: bun run test:visual
+        run: bun run test:visual:studio
       - uses: actions/upload-artifact@v7
         if: failure()
         with:
@@ -216,8 +223,8 @@
           key: wails-bindings-${{ hashFiles('go.mod') }}
       - name: Generate Wails bindings
         run: sh scripts/setup.sh
-      - name: Build frontend bundle (main.go's `//go:embed all:frontend/dist` needs this directory to exist before Go can even compile the root package — checks (macOS) covers this via its own `bun run build`, but container-tests' `go test ./...` reaches the same package and needs it too)
-        run: bun run build
+      - name: Build frontend bundle (main.go's `//go:embed all:frontend/dist` needs this directory to exist before Go can even compile the root package — checks (macOS) covers this via its own `bun run build:studio`, but container-tests' `go test ./...` reaches the same package and needs it too)
+        run: bun run build:studio
       - run: bun run test:unit
       - name: Raise the inotify instance limit (v1.4 P1 — internal/gitsock and internal/gitsession now run t.Parallel(); each open repo holds one fsnotify watcher = one inotify instance, and Ubuntu's stock 128 is low enough for the parallel suite to exhaust it and hang rather than fail cleanly, confirmed by reproducing the hang at 128 and it clearing at 8192)
         run: sudo sysctl -w fs.inotify.max_user_instances=8192
