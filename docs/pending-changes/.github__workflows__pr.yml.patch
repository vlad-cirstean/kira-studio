# Why: actions/cache v4 to v6.1.0, upload-artifact v7.0.1 to v7.0.2 (P442). Apply with: git apply docs/pending-changes/.github__workflows__pr.yml.patch
diff --git a/.github/workflows/pr.yml b/.github/workflows/pr.yml
index 888b92bb4..6d0c8ca1e 100644
--- a/.github/workflows/pr.yml
+++ b/.github/workflows/pr.yml
@@ -31,7 +31,7 @@ jobs:
         run: bun run build:studio
       - run: bun run build:space
       - name: Cache golangci-lint binary (keyed on the install script, which pins the version, and go.mod, which pins the toolchain it's built against)
-        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
         with:
           path: ~/go/bin/golangci-lint
           key: golangci-lint-${{ runner.os }}-${{ hashFiles('scripts/install-golangci-lint.sh', 'go.mod') }}
@@ -62,7 +62,7 @@ jobs:
           gtk: "true"
       - run: bun run lint
       - name: Cache tsbuildinfo (tsc and vue-tsc incremental mode key on file content hashes, so a fresh checkout reuses entries)
-        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
         with:
           path: node_modules/.cache/tsbuildinfo
           key: tsbuildinfo-${{ hashFiles('bun.lock') }}-${{ github.sha }}
@@ -89,7 +89,7 @@ jobs:
       - uses: ./.github/actions/setup
         timeout-minutes: 10
       - name: Cache Playwright browsers (keyed on the lockfile, which pins the @playwright/test version)
-        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
         with:
           path: ~/.cache/ms-playwright
           key: playwright-${{ runner.os }}-webkit-${{ hashFiles('bun.lock') }}
@@ -98,7 +98,7 @@ jobs:
         timeout-minutes: 7
       - run: bun run build:test:studio
       - run: bunx playwright test --config=apps/kira-studio/playwright.config.ts --project=ui --shard=${{ matrix.shard }}/4
-      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
         if: failure()
         with:
           name: playwright-report-ui-${{ matrix.shard }}
@@ -120,7 +120,7 @@ jobs:
         with:
           visual-fonts: "true"
       - name: Cache Playwright browsers (keyed on the lockfile, which pins the @playwright/test version)
-        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
         with:
           path: ~/.cache/ms-playwright
           key: playwright-${{ runner.os }}-webkit-chromium-${{ hashFiles('bun.lock') }}
@@ -136,7 +136,7 @@ jobs:
         run: bunx playwright test --config=apps/kira-studio/playwright.config.ts --project=visual
       - name: Wall-clock budget tests (alone, no other browser contending for the CPU)
         run: bunx playwright test --config=apps/kira-studio/playwright.config.ts --project=ui-timing --no-deps
-      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
         if: failure()
         with:
           name: playwright-report-extra
@@ -182,7 +182,7 @@ jobs:
           touch apps/kira-space/frontend/dist/.keep apps/kira-space/frontend/dist-mobile/.keep apps/kira-studio/frontend/dist/.keep
       - name: Restore cached Testcontainers images (keyed on the pinned image tags, so an unchanged adapter-test image set skips re-pulling)
         id: docker-cache
-        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
         with:
           path: ~/docker-images.tar
           key: docker-${{ runner.os }}-${{ hashFiles('apps/kira-studio/internal/adapters/testsupport/*.go') }}
@@ -225,7 +225,7 @@ jobs:
           docker save $(docker images --filter dangling=false --format '{{.Repository}}:{{.Tag}}') -o ~/docker-images.tar
       - name: Cache pulled Testcontainers images
         if: always() && steps.docker-cache.outputs.cache-hit != 'true'
-        uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
         with:
           path: ~/docker-images.tar
           key: docker-${{ runner.os }}-${{ hashFiles('apps/kira-studio/internal/adapters/testsupport/*.go') }}
