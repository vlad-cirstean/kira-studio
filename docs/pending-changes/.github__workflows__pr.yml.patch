Why: docker save by image ID drops repository tags, so a cache hit restores untagged images and Testcontainers pulls them all again. Save by name (P301 3.1).

diff --git a/.github/workflows/pr.yml b/.github/workflows/pr.yml
index d1e4c9b..5f1478e 100644
--- a/.github/workflows/pr.yml
+++ b/.github/workflows/pr.yml
@@ -215,7 +215,7 @@ jobs:
         run: sh scripts/go-test-split.sh containers
       - name: Save pulled Testcontainers images (always() so a partial pull from a failed run still seeds the next one)
         if: always() && steps.docker-cache.outputs.cache-hit != 'true'
-        run: docker save $(docker images -q) -o ~/docker-images.tar
+        run: docker save $(docker images --filter dangling=false --format '{{.Repository}}:{{.Tag}}') -o ~/docker-images.tar
       - name: Cache pulled Testcontainers images
         if: always() && steps.docker-cache.outputs.cache-hit != 'true'
         uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
