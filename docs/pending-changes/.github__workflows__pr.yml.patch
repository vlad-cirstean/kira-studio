P365: step timeouts on setup, WebKit install and image wait; retry the Playwright install (hung apt/network fetches).
diff --git a/.github/workflows/pr.yml b/.github/workflows/pr.yml
index 96efb9fda..fe56cd18d 100644
--- a/.github/workflows/pr.yml
+++ b/.github/workflows/pr.yml
@@ -24,6 +24,7 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
       - uses: ./.github/actions/setup
+        timeout-minutes: 10
         with:
           go-cache: macos
       - name: Build frontend bundle (main.go's `//go:embed all:frontend/dist` needs this directory to exist before Go can compile the root package for both apps)
@@ -55,6 +56,7 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
       - uses: ./.github/actions/setup
+        timeout-minutes: 10
         with:
           go-cache: checks
           gtk: "true"
@@ -85,13 +87,15 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
       - uses: ./.github/actions/setup
+        timeout-minutes: 10
       - name: Cache Playwright browsers (keyed on the lockfile, which pins the @playwright/test version)
         uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
         with:
           path: ~/.cache/ms-playwright
           key: playwright-${{ runner.os }}-webkit-${{ hashFiles('bun.lock') }}
       - name: Install WebKit with its system libraries
-        run: bunx playwright install --with-deps webkit
+        run: sh scripts/retry.sh 2 180 bunx playwright install --with-deps webkit
+        timeout-minutes: 7
       - run: bun run build:test:studio
       - run: bunx playwright test --config=apps/kira-studio/playwright.config.ts --project=ui --shard=${{ matrix.shard }}/4
       - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
@@ -114,6 +118,7 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
       - uses: ./.github/actions/setup
+        timeout-minutes: 10
         with:
           visual-fonts: "true"
       - name: Cache Playwright browsers (keyed on the lockfile, which pins the @playwright/test version)
@@ -122,7 +127,8 @@ jobs:
           path: ~/.cache/ms-playwright
           key: playwright-${{ runner.os }}-webkit-chromium-${{ hashFiles('bun.lock') }}
       - name: Install WebKit and Chromium with their system libraries
-        run: bunx playwright install --with-deps webkit chromium
+        run: sh scripts/retry.sh 2 240 bunx playwright install --with-deps webkit chromium
+        timeout-minutes: 9
       - run: bun run build:test:studio
       - name: IPC frontend tests (consume the fixtures internal/adapters/*'s own suites generate)
         run: bunx playwright test --config=apps/kira-studio/playwright.config.ts --project=ipc-frontend
@@ -151,6 +157,7 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
       - uses: ./.github/actions/setup
+        timeout-minutes: 10
         with:
           go-cache: go-rest
           gtk: "true"
@@ -189,6 +196,7 @@ jobs:
           nohup docker load -i ~/docker-images.tar > "$RUNNER_TEMP/images.log" 2>&1 &
           echo $! > "$RUNNER_TEMP/images.pid"
       - uses: ./.github/actions/setup
+        timeout-minutes: 10
         with:
           bun: "false"
           bindings: "false"
@@ -206,6 +214,7 @@ jobs:
       - name: Raise the inotify instance limit (see the go job)
         run: sudo sysctl -w fs.inotify.max_user_instances=8192
       - name: Wait for the images
+        timeout-minutes: 10
         run: |
           while kill -0 "$(cat "$RUNNER_TEMP/images.pid")" 2>/dev/null; do sleep 2; done
           cat "$RUNNER_TEMP/images.log"
