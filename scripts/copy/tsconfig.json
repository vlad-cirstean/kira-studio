{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "types": ["bun-types"]
  },
  "include": ["*.ts", "../check-conventions.ts", "../check-conventions.spec.ts"]
}
