{
  "name": "kira-studio",
  "version": "0.0.0",
  "description": "A visual database client for macOS, covering MariaDB, PostgreSQL, MongoDB, Redis, Kafka, SQS, and S3.",
  "author": "Vlad Cirstean",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*/frontend"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "setup": "sh scripts/install-deps.sh && sh scripts/wails-dev-setup.sh",
    "predev": "bun run setup",
    "dev": "PATH=\"$PATH:$(go env GOPATH)/bin\" sh -c 'cd apps/kira-studio && wails3 task dev'",
    "build": "cd apps/kira-studio/frontend && bun run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run typecheck:tests && bun run typecheck:web && bun run typecheck:unit",
    "typecheck:tests": "tsgo --noEmit -p apps/kira-studio/tsconfig.tests.json",
    "typecheck:web": "vue-tsc --noEmit -p apps/kira-studio/frontend/tsconfig.json",
    "typecheck:unit": "tsgo --noEmit -p apps/kira-studio/tests/unit/tsconfig.json",
    "test:ui": "bun run build && playwright test --config=apps/kira-studio/playwright.config.ts --project=ui",
    "test:ipc:fe": "bun run build && playwright test --config=apps/kira-studio/playwright.config.ts --project=ipc-frontend",
    "test:unit": "bun test apps/kira-studio/tests/unit",
    "prepackage": "bun run setup",
    "package": "PATH=\"$PATH:$(go env GOPATH)/bin\" sh -c 'cd apps/kira-studio && wails3 task darwin:package:dmg && sh ../../scripts/sign-bundle.sh'",
    "verify:packaging": "sh scripts/verify-packaging.sh",
    "test:go": "go test ./...",
    "test:compat": "sh scripts/db-compat.sh",
    "generate:wire": "sh scripts/generate-wire.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@faker-js/faker": "10.6.0",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-virtual": "3.13.36",
    "@testcontainers/kafka": "12.1.0",
    "@testcontainers/mariadb": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vscode/codicons": "0.0.46-24",
    "@wailsio/runtime": "3.0.0-beta.15",
    "bun-types": "1.4.0",
    "mariadb": "3.5.3",
    "pg": "8.23.0",
    "simple-icons": "16.28.0",
    "sql-formatter": "15.8.2",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "flatbuffers": "25.9.23",
    "zod": "4.4.3"
  }
}
