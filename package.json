{
  "name": "kira-studio",
  "version": "0.1.0",
  "description": "A visual database client (DataGrip/DBeaver class) for macOS, covering MariaDB, PostgreSQL, MongoDB, Redis, Kafka, SQS, and S3.",
  "author": "kirathecat",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "trustedDependencies": [
    "electron",
    "esbuild",
    "@confluentinc/kafka-javascript"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "predev": "sh scripts/native-electron-build.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:db && bun run typecheck:unit",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:db": "tsgo --noEmit -p tests/db/tsconfig.json && tsgo --noEmit -p tests/electron-db/tsconfig.json",
    "typecheck:unit": "tsgo --noEmit -p tests/unit/tsconfig.json",
    "pretest:ui": "sh scripts/native-electron-build.sh",
    "test:ui": "electron-vite build && playwright test",
    "test:db": "bun test tests/db && bun run test:db:kafka",
    "test:unit": "bun test tests/unit",
    "pretest:db:kafka": "sh scripts/native-electron-build.sh",
    "test:db:kafka": "bunx esbuild tests/electron-db/kafka.spec.ts --bundle --platform=node --external:electron --external:@confluentinc/kafka-javascript --external:ssh2 --external:cpu-features --outfile=out/tests/kafka-suite.cjs && ELECTRON_RUN_AS_NODE=1 electron out/tests/kafka-suite.cjs",
    "prepackage:mac": "sh scripts/native-electron-build.sh",
    "package:mac": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "package:mac:dir": "electron-vite build && electron-builder --mac --arm64 --dir --publish never",
    "verify:packaging": "sh scripts/verify-packaging.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@electron/rebuild": "4.2.0",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-virtual": "3.13.36",
    "@testcontainers/clickhouse": "12.1.0",
    "@testcontainers/kafka": "12.1.0",
    "@testcontainers/localstack": "12.1.0",
    "@testcontainers/mariadb": "12.1.0",
    "@testcontainers/mysql": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/rabbitmq": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vscode/codicons": "0.0.46-24",
    "bun-types": "1.4.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "simple-icons": "16.28.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1118.0",
    "@aws-sdk/client-sqs": "3.1118.0",
    "@aws-sdk/credential-providers": "3.1118.0",
    "@clickhouse/client": "1.23.1",
    "@confluentinc/kafka-javascript": "1.10.0",
    "bson": "7.3.2",
    "drizzle-orm": "0.45.2",
    "electron-log": "5.4.4",
    "ioredis": "6.0.0",
    "mariadb": "3.5.3",
    "mongodb": "7.6.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
  }
}
