{
  "name": "kira-studio",
  "version": "0.0.0",
  "description": "A visual database client for macOS, covering MariaDB, PostgreSQL, MongoDB, Redis, Kafka, SQS, and S3.",
  "author": "Vlad Cirstean",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*/frontend",
    "apps/kira-studio-vscode",
    "packages/shared",
    "packages/api-core",
    "packages/git-ipc",
    "packages/git-core",
    "packages/git-ui",
    "packages/kira-ui"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "setup": "sh scripts/setup.sh",
    "predev": "bun run setup",
    "dev": "PATH=\"$PATH:$(go env GOPATH)/bin\" sh -c 'cd apps/kira-studio && wails3 task dev'",
    "build": "cd apps/kira-studio/frontend && bun run build",
    "build:test": "cd apps/kira-studio/frontend && bun run build:test",
    "build:vscode": "bun run scripts/build-vscode.ts",
    "package:vscode": "bun run scripts/package-vscode.ts",
    "lint": "biome check . && sh scripts/check-tokens.sh",
    "format": "biome check --write .",
    "typecheck": "sh -c 'bun run typecheck:tests & p1=$!; bun run typecheck:web & p2=$!; bun run typecheck:unit & p3=$!; bun run typecheck:api-core & p4=$!; bun run typecheck:git & p5=$!; fail=0; wait $p1 || fail=1; wait $p2 || fail=1; wait $p3 || fail=1; wait $p4 || fail=1; wait $p5 || fail=1; exit $fail'",
    "typecheck:tests": "tsgo --noEmit -p apps/kira-studio/tsconfig.tests.json",
    "typecheck:web": "vue-tsc --noEmit -p apps/kira-studio/frontend/tsconfig.json",
    "typecheck:unit": "tsgo --noEmit -p apps/kira-studio/tests/unit/tsconfig.json",
    "typecheck:api-core": "tsgo --noEmit -p packages/api-core/tsconfig.json",
    "typecheck:git": "tsgo --noEmit -p packages/git-ipc/tsconfig.json && tsgo --noEmit -p packages/git-core/tsconfig.json && tsgo --noEmit -p apps/kira-studio-vscode/tsconfig.json && vue-tsc --noEmit -p packages/git-ui/tsconfig.json && vue-tsc --noEmit -p packages/kira-ui/tsconfig.json",
    "test:ui": "bun run build:test && playwright test --config=apps/kira-studio/playwright.config.ts --project=ui --project=ui-timing",
    "test:visual": "bun run build:test && playwright test --config=apps/kira-studio/playwright.config.ts --project=visual",
    "test:visual:update": "bun run build:test && playwright test --config=apps/kira-studio/playwright.config.ts --project=visual --update-snapshots",
    "test:webview": "bun run build:vscode && playwright test --config=apps/kira-studio-vscode/playwright.config.ts",
    "test:ipc:fe": "bun run build:test && playwright test --config=apps/kira-studio/playwright.config.ts --project=ipc-frontend",
    "test:unit": "bun test apps/kira-studio/tests/unit packages/api-core/test packages/git-core/src packages/git-ipc/src apps/kira-studio-vscode/src packages/git-ui/src packages/kira-ui/src",
    "test:e2e-real": "bun run build && node node_modules/.bin/playwright test --config=apps/kira-studio/playwright.config.ts --project=e2e-real",
    "prepackage": "bun run setup",
    "package": "PATH=\"$PATH:$(go env GOPATH)/bin\" sh -c 'cd apps/kira-studio && wails3 task darwin:package:dmg && sh ../../scripts/sign-bundle.sh'",
    "verify:packaging": "sh scripts/verify-packaging.sh",
    "test:go": "go test ./...",
    "test:compat": "sh scripts/db-compat.sh",
    "test:matrix": "sh scripts/test-matrix.sh",
    "generate:wire": "sh scripts/generate-wire.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.10",
    "@faker-js/faker": "10.6.0",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testcontainers/kafka": "12.1.0",
    "@testcontainers/mariadb": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/vscode": "1.134.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/vsce": "3.9.2",
    "@wailsio/runtime": "3.0.0-beta.16",
    "bun-types": "1.4.0",
    "mariadb": "3.5.4",
    "pg": "8.23.0",
    "simple-icons": "16.29.0",
    "sql-formatter": "15.8.2",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "flatbuffers": "25.9.23",
    "shlex": "3.0.0",
    "slickgrid": "5.20.0",
    "zod": "4.5.4"
  }
}
