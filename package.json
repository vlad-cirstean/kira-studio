{
  "name": "kira-studio",
  "version": "0.0.0",
  "description": "A visual database client for macOS, covering MariaDB, PostgreSQL, MongoDB, Redis, Kafka, SQS, and S3.",
  "author": "Vlad Cirstean",
  "license": "MIT",
  "private": true,
  "trustedDependencies": [
    "esbuild",
    "@confluentinc/kafka-javascript"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "predev": "sh scripts/wails-dev-setup.sh",
    "dev": "PATH=\"$PATH:$(go env GOPATH)/bin\" sh -c 'bun run build && cd shell && wails3 task dev'",
    "build": "vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:unit",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:unit": "tsgo --noEmit -p tests/unit/tsconfig.json",
    "test:ui": "bun run build && playwright test --project=ui",
    "test:ipc:fe": "bun run build && playwright test --project=ipc-frontend",
    "test:unit": "bun test tests/unit",
    "package": "PATH=\"$PATH:$(go env GOPATH)/bin\" sh -c 'cd shell && wails3 task darwin:package && sh ../scripts/sign-bundle.sh'",
    "verify:packaging": "sh scripts/verify-packaging.sh",
    "build:engine": "bunx esbuild src/engine/stdio-main.ts --bundle --platform=node --format=cjs --alias:@shared=./src/shared --external:@confluentinc/kafka-javascript --external:ssh2 --external:cpu-features --outfile=shell/runtime/engine/engine.cjs",
    "test:go": "cd shell && go test ./..."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-virtual": "3.13.36",
    "@testcontainers/clickhouse": "12.1.0",
    "@testcontainers/kafka": "12.1.0",
    "@testcontainers/localstack": "12.1.0",
    "@testcontainers/mariadb": "12.1.0",
    "@testcontainers/mysql": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vscode/codicons": "0.0.46-24",
    "@wailsio/runtime": "3.0.0-beta.15",
    "bun-types": "1.4.0",
    "simple-icons": "16.28.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1118.0",
    "@aws-sdk/client-sqs": "3.1118.0",
    "@aws-sdk/credential-providers": "3.1118.0",
    "@clickhouse/client": "1.23.1",
    "@confluentinc/kafka-javascript": "1.10.0",
    "bson": "7.3.2",
    "ioredis": "6.0.0",
    "mariadb": "3.5.3",
    "mongodb": "7.6.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
  }
}
